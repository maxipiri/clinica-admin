# Variables de entorno — Clínica Admin

# Supabase
# Obtén estos valores en: supabase.com → tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# IMPORTANTE:
# - Copia este archivo como .env.local y rellena los valores reales.
# - NUNCA subas .env.local al repositorio.
# - La service_role key NUNCA va aquí ni en Vercel como NEXT_PUBLIC_.
